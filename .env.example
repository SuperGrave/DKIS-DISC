LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# 中間要約（検索・ニュース・READ-PAGE）用。未設定時は OPENAI_MODEL と同じ。
OPENAI_SUMMARY_MODEL=
DKIS_SYSTEM_PROMPT=

# Google Programmable Search（Custom Search JSON API）。未設定だと SEARCH は案内メッセージのみ。
GOOGLE_API_KEY=
GOOGLE_CX=
GOOGLE_SEARCH_NUM=5

# true のとき要約を挟まず生結果を RETRY に渡す（コンテキスト消費に注意）
SEARCH_USE_RAW_RESULT=false
NEWS_USE_RAW_RESULT=false
WEBPAGE_USE_RAW_RESULT=false
NEWS_MAX_ITEMS=12

# 「現在地」指定時のフォールバック（LINE はサーバー GPS なし）
DEFAULT_WEATHER_LOCATION=東京

MAX_RETRY_CHAIN=5
MAX_HISTORY_TURNS=8

PORT=5000
