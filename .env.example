# =============================================================================
# コピーして使う: このファイルをコピーし、名前を .env にしてから値を埋めてください。
#   PowerShell:  copy .env.example .env
# =============================================================================

# --- Discord bot / main.py / 本番では必須 ---
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
# テスト中は対象サーバーIDを入れるとスラッシュコマンド反映が速いです。
# DISCORD_GUILD_ID=
# 指定チャンネルでは通常会話、それ以外ではメンション時だけ反応します。
DISCORD_MESSAGE_MODE=hybrid
# 管理者扱いにするDiscordユーザーID（任意・カンマ区切り）。
# DISCORD_ADMIN_USER_IDS=
# Presence更新間隔（最小30秒）。例: run in 2/4ch・RAM 48%
# DISCORD_STATUS_INTERVAL_SECONDS=60
# Presence表示モード: auto（接続中ならonline/run、未接続ならidle/sleep）| run | sleep
# DISCORD_STATUS_MODE=auto
#
# チャンネル別設定はSupabaseの channel_settings に保存します。
# /channel_setting_set で enabled=on|off、response_mode=inherit|normal|mention|off、
# tool_notice_display=inherit|full|abbrev|minimal|hidden をチャンネルIDごとに変更できます。
# enabled=off のチャンネルでは、管理者の enabled=on 以外のコマンドを受け付けません。

# サーバー再起動コマンドを許可する Discord ユーザー ID（任意・カンマ区切り）。
# 未設定時は Discord サーバー管理者だけが「サーバー再起動」を実行できます。
# DISCORD_RESTART_ALLOWED_USER_IDS=

# ワーカー起動時に DISCORD_CHANNEL_ID へ一言（任意）。
# DB … 過去に発話した Discord userId のうち、/setting_set notify_worker_restart=true のユーザーは次回履歴にも反映
# DISCORD_BOOT_GREETING_PUSH_STORE_LIMIT=50
# DISCORD_BOOT_GREETING_SKIP_STORED_IDS=0

# --- 必須（開発コンソールもここだけあれば起動する）---
# OpenAI → API keys（ https://platform.openai.com/api-keys など）
OPENAI_API_KEY=

# --- 任意 ---
# 設定 JSON を別パスにしたいときだけ（未設定ならリポジトリ内 dist/settings.json）
# DKIS_SETTINGS_PATH=C:\\path\\to\\settings.json

# SEARCH コマンド用（未設定なら検索は案内のみになります）
GOOGLE_API_KEY=
GOOGLE_CX=

# --- Supabase（記憶ファイル・設定の永続化。未設定なら記憶コマンドはエラー文言のみ）---
# Project Settings → API（Project URL と service_role の secret）
SUPABASE_URL=
SUPABASE_KEY=

# Render Web Service のヘルスチェック用ポート（Discord bot 本体とは別に軽量 HTTP サーバーを起動）
PORT=5000

# Render のスリープ対策（任意）。Render の External URL か、外部監視 URL を入れる。
# KEEPALIVE_URL=https://<サービス名>.onrender.com/
# KEEPALIVE_INTERVAL_SECONDS=900
# DISABLE_KEEPALIVE=0
