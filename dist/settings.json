{
  "ai_models": {
    "main": "gpt-5.4-mini",
    "allowed_chat_models": [
      "gpt-5.5",
      "gpt-5.5-pro",
      "gpt-5.4",
      "gpt-5.4-mini",
      "gpt-5.4-nano",
      "gpt-5.4-pro",
      "gpt-5.2",
      "gpt-5.2-pro",
      "gpt-5.1",
      "gpt-5",
      "gpt-5-mini",
      "gpt-5-nano",
      "gpt-5-pro",
      "gpt-4.1",
      "gpt-4.1-mini",
      "gpt-4.1-nano"
    ]
  },
  "system_prompts": {
    "main_file": "system_prompt_main.txt"
  },
  "search": {
    "result_count": 5
  },
  "news": {
    "max_items": 10
  },
  "webpage": {},
  "weather": {
    "api_timeout": 12,
    "open_meteo_url": "https://api.open-meteo.com/v1/forecast"
  },
  "control": {
    "max_retries": 10,
    "max_history": 24,
    "max_retry_payload_chars": 10000,
    "reset_history_on_prompt_change": false
  },
  "notifications": {
    "restart_push_enabled": true
  },
  "input_format": {
    "main": {
      "mode": "all",
      "include": {
        "last_result": true,
        "location": false,
        "time": true
      },
      "labels": {
        "user": "UI：",
        "retry": "RI：",
        "last_result": "LP：",
        "time": "NT："
      }
    }
  }
}
