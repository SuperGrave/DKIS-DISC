{
  "ai_models": {
    "main": "gpt-5.4-mini"
  },
  "system_prompts": {
    "main_file": "system_prompt_main.txt"
  },
  "search": {
    "result_count": 5
  },
  "news": {
    "max_items": 10
  },
  "webpage": {},
  "weather": {
    "api_timeout": 12,
    "open_meteo_url": "https://api.open-meteo.com/v1/forecast"
  },
  "control": {
    "max_retries": 10,
    "max_history": 10,
    "max_retry_payload_chars": 10000,
    "reset_history_on_prompt_change": false
  },
  "input_format": {
    "main": {
      "mode": "all",
      "include": {
        "last_result": true,
        "location": false,
        "time": true
      },
      "labels": {
        "user": "UI：",
        "retry": "RI：",
        "last_result": "LP：",
        "time": "NT："
      }
    }
  }
}
