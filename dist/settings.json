{
  "ai_models": {
    "main": "gpt-5.4-mini"
  },
  "system_prompts": {
    "main_file": "system_prompt_main.txt"
  },
  "search": {
    "result_count": 5
  },
  "news": {
    "max_items": 10
  },
  "webpage": {},
  "weather": {
    "api_timeout": 12,
    "open_meteo_url": "https://api.open-meteo.com/v1/forecast"
  },
  "control": {
    "max_retries": 10,
    "max_history": 10,
    "reset_history_on_prompt_change": false
  },
  "input_format": {
    "main": {
      "mode": "all",
      "include": {
        "last_result": true,
        "location": true,
        "time": true
      },
      "labels": {
        "user": "UI：",
        "retry": "RI：",
        "last_result": "LP：",
        "location": "NL：",
        "time": "NT："
      },
      "nl_static": "LINEのためサーバーはGPSや現在地を取得できません。天気は WEATHER の w_location にマスターの発話または文脈から特定した具体的地名を必ず入れてください。地名が断定できないときは WEATHER を実行せず SPEAK で地名を確認してください。なお RI には検索・ニュース・ページ本文・天気テキストなどツールの生結果がそのまま渡ります。"
    }
  }
}
